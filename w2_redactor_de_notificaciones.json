    {
      "parameters": {
        "jsCode": "// W2 · Redactor de Notificaciones — tarea atómica: armar el aviso para Mariela.\n// Mantiene el formato de la tool notificar_asesor_humano del M1, ahora con plantilla fija.\nconst i = $input.first().json;\nconst v = (x) => (x ?? '').toString().trim() || 'no informado';\nconst TIPOS = ['LEAD', 'POSTVENTA', 'REVISION_HUMANA'];\n\nif (!TIPOS.includes(i.tipo)) {\n  throw new Error(`Contrato inválido: tipo \"${i.tipo}\" no está en ${TIPOS.join(', ')}`);\n}\n\nconst ramo = (i.ramo && i.ramo !== 'NO_IDENTIFICADO') ? i.ramo : 'ramo no identificado';\n\nlet asunto;\nif (i.tipo === 'LEAD') {\n  asunto = `Lead ${ramo} - ${v(i.bien)} [${v(i.temperatura)}]`;\n} else if (i.tipo === 'POSTVENTA') {\n  asunto = `Postventa ${ramo} - requiere atención personal`;\n} else {\n  asunto = `Atención humana - ${ramo}`;\n}\n\nconst campos = [\n  `Nombre: ${v(i.nombre)}`,\n  `Contacto: ${v(i.contacto)}`,\n  `Localidad: ${v(i.localidad)}`,\n  `Ramo: ${v(i.ramo)}`,\n  `Bien a asegurar: ${v(i.bien)}`,\n  `Motivo de la derivación: ${v(i.motivo)}`,\n  `Resumen del pedido: ${v(i.mensaje)}`,\n];\n\nif (i.tipo === 'LEAD') {\n  campos.push('', `Temperatura: ${v(i.temperatura)}`, `Datos faltantes: ${i.faltantes ? i.faltantes : 'ninguno'}`);\n}\ncampos.push('', `Sesión: ${v(i.session_id)}`);\n\nreturn [{ json: { tipo: i.tipo, asunto, cuerpo: campos.join('\\n') } }];\n"
      },
      "id": "5a9a76d9-d825-46cc-b950-0a05de5f1a3a",
      "name": "Redactar correo",
      "type": "n8n-nodes-base.code",
